services:
  recovery_db:
    image: mariadb:11.4
    container_name: social_recovery_hml_db
    restart: unless-stopped
    environment:
      MARIADB_DATABASE: ${RECOVERY_DB_DATABASE:-vitrine_social_recovery}
      MARIADB_USER: ${RECOVERY_DB_USERNAME:-vitrine_social_recovery}
      MARIADB_PASSWORD: ${RECOVERY_DB_PASSWORD:?RECOVERY_DB_PASSWORD is required}
      MARIADB_ROOT_PASSWORD: ${RECOVERY_DB_ROOT_PASSWORD:?RECOVERY_DB_ROOT_PASSWORD is required}
    volumes:
      - recovery_db_data:/var/lib/mysql
    networks:
      - recovery_internal
    healthcheck:
      test: ["CMD", "healthcheck.sh", "--connect", "--innodb_initialized"]
      interval: 10s
      timeout: 5s
      retries: 10

  recovery_redis:
    image: redis:7-alpine
    container_name: social_recovery_hml_redis
    restart: unless-stopped
    command: ["redis-server", "--requirepass", "${RECOVERY_REDIS_PASSWORD:?RECOVERY_REDIS_PASSWORD is required}"]
    volumes:
      - recovery_redis_data:/data
    networks:
      - recovery_internal
    healthcheck:
      test: ["CMD-SHELL", "redis-cli -a \"$$RECOVERY_REDIS_PASSWORD\" ping | grep PONG"]
      interval: 10s
      timeout: 5s
      retries: 10
    environment:
      RECOVERY_REDIS_PASSWORD: ${RECOVERY_REDIS_PASSWORD:?RECOVERY_REDIS_PASSWORD is required}

  recovery_app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: social_recovery_hml_app
    restart: unless-stopped
    environment: &app_environment
      APP_NAME: Vitrine Social Midia Recovery HML
      APP_ENV: local
      APP_DEBUG: "true"
      APP_URL: http://127.0.0.1:18090
      APP_KEY: ${RECOVERY_APP_KEY:?RECOVERY_APP_KEY is required}
      LOG_CHANNEL: stderr
      DB_CONNECTION: mysql
      DB_HOST: recovery_db
      DB_PORT: 3306
      DB_DATABASE: ${RECOVERY_DB_DATABASE:-vitrine_social_recovery}
      DB_USERNAME: ${RECOVERY_DB_USERNAME:-vitrine_social_recovery}
      DB_PASSWORD: ${RECOVERY_DB_PASSWORD:?RECOVERY_DB_PASSWORD is required}
      CACHE_STORE: redis
      QUEUE_CONNECTION: redis
      SESSION_DRIVER: file
      REDIS_CLIENT: phpredis
      REDIS_HOST: recovery_redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: ${RECOVERY_REDIS_PASSWORD:?RECOVERY_REDIS_PASSWORD is required}
      FILESYSTEM_DISK: public
    volumes:
      - ./:/var/www/html
      - recovery_vendor:/var/www/html/vendor
      - recovery_storage:/var/www/html/storage
    depends_on:
      recovery_db:
        condition: service_healthy
      recovery_redis:
        condition: service_healthy
    networks:
      - recovery_internal

  recovery_web:
    image: nginx:stable
    container_name: social_recovery_hml_web
    restart: unless-stopped
    depends_on:
      - recovery_app
    ports:
      - "127.0.0.1:18090:80"
    volumes:
      - ./:/var/www/html:ro
      - ./docker/nginx/recovery.conf:/etc/nginx/conf.d/default.conf:ro
      - recovery_storage:/var/www/html/storage:ro
    networks:
      - recovery_internal

  recovery_worker:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: social_recovery_hml_worker
    restart: unless-stopped
    environment: *app_environment
    command: php artisan queue:work --sleep=3 --tries=1 --timeout=120 --max-time=3600
    volumes:
      - ./:/var/www/html
      - recovery_vendor:/var/www/html/vendor
      - recovery_storage:/var/www/html/storage
    depends_on:
      recovery_db:
        condition: service_healthy
      recovery_redis:
        condition: service_healthy
    networks:
      - recovery_internal

volumes:
  recovery_db_data:
  recovery_redis_data:
  recovery_vendor:
  recovery_storage:

networks:
  recovery_internal:
    name: vitrine_social_recovery_hml_internal
    internal: true
